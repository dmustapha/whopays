# WhoPays — credentials manifest (forge Step 4C-5). Placeholders only — real values live in .env.local / convex env.
# Convex deployment — obtain: `npx convex dev` device auth (dashboard.convex.dev)
CONVEX_DEPLOYMENT=dev:DEPLOY_AND_RECORD
VITE_CONVEX_URL=https://DEPLOY_AND_RECORD.convex.cloud
# OpenAI — obtain: platform.openai.com — ALREADY COLLECTED + VALIDATED (in .env.local)
OPENAI_API_KEY=sk-proj-placeholder
# Firecrawl — obtain: firecrawl.dev dashboard (20k event credits) — DAMI, before build hour-1 (G1)
FIRECRAWL_API_KEY=fc-placeholder
# AgentMail — obtain: agentmail.to signup (free tier) — DAMI, before build hour-1 (G2)
AGENTMAIL_API_KEY=am-placeholder
# AgentMail webhook secret — obtain: AgentMail dashboard at webhook registration (build G2)
AGENTMAIL_WEBHOOK_SECRET=whsec-placeholder
# Plan inbox id — generated at deploy: seed-demo/createInbox records it
AGENTMAIL_INBOX_ID=DEPLOY_AND_RECORD
# Owner console secret — generated at build: `openssl rand -hex 16`
OWNER_SECRET=choose-a-strong-string
# Baked by the deploy step — generated at deploy
BUILD_COMMIT=DEPLOY_AND_RECORD
BUILD_DEPLOYED_AT=DEPLOY_AND_RECORD
SITE_HOST=DEPLOY_AND_RECORD.convex.site
